@*
    Nombre del archivo: Index.cshtml
    Descripción: Muestra el listado de usuarios registrados en el sistema.
*@

@model IEnumerable<CIEMPOS.Models.TbUsuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h2>Usuarios</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Usuario
    </a>
</div>

<form method="get" class="mb-3">
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="mostrarInactivos"
               name="mostrarInactivos"
               value="true"
               @(ViewBag.MostrarInactivos ? "checked" : "")
               onchange="this.form.submit();" />

        <label class="form-check-label" for="mostrarInactivos">
            Mostrar usuarios inactivos
        </label>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Persona</th>
            <th>Rol</th>
            <th>Estado</th>
            <th style="width: 120px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>
                    @($"{usuario.IdPersonaNavigation?.Nombre} {usuario.IdPersonaNavigation?.Apellido}")
                </td>
                <td>
                    @usuario.IdRolNavigation?.Nombre
                </td>
                <td>
                    @(usuario.Estado ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@usuario.IdUsuario"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>