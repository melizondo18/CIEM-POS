@* Esta vista muestra la lista de roles registrados en el sistema.
   Permite visualizar la información de cada rol y acceder al
   formulario para registrar nuevos roles o modificar los existentes. *@

@model IEnumerable<CIEMPOS.Models.TbRol>

@{
    ViewData["Title"] = "Roles";
}

<h2>Lista de Roles</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Rol
    </a>
</p>

<form asp-action="Index" method="get" class="mb-3">

    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="mostrarInactivos"
               name="mostrarInactivos"
               value="true"
               @(Context.Request.Query["mostrarInactivos"] == "true" ? "checked" : "")
               onchange="this.form.submit();" />

        <label class="form-check-label" for="mostrarInactivos">
            Mostrar roles inactivos
        </label>
    </div>

</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rol in Model)
        {
            <tr>
                <td>@rol.IdRol</td>
                <td>@rol.Nombre</td>
                <td>@rol.Descripcion</td>
                <td>@(rol.Estado ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@rol.IdRol"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>