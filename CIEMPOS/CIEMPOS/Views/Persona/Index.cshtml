@* Esta vista muestra la lista de personas registradas en el sistema.
    Permite visualizar la información de cada persona y acceder al
    formulario para registrar nuevas personas o modificar las existentes. *@

@model IEnumerable<CIEMPOS.Models.TbPersona>

    @{
    ViewData["Title"] = "Personas";
    }

    <h2>Lista de Personas</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Nueva Persona
        </a>
    </p>

    <form asp-action="Index" method="get" class="mb-3">

        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   id="mostrarInactivos"
                   name="mostrarInactivos"
                   value="true"
                   @(Context.Request.Query["mostrarInactivos"] == "true" ? "checked" : "")
                   onchange="this.form.submit();" />

            <label class="form-check-label" for="mostrarInactivos">
                Mostrar personas inactivas
            </label>
        </div>

    </form>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre Completo</th>
                <th>Identificación</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var persona in Model)
        {
            <tr>
                <td>@persona.IdPersona</td>
                <td>@persona.Nombre @persona.Apellido</td>
                <td>@persona.Identificacion</td>
                <td>@persona.Email</td>
                <td>@persona.Telefono</td>
                <td>@(persona.Estado ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@persona.IdPersona"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
