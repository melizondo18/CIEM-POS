@*
    Muestra el historial de pagos registrados en el sistema.
*@

@model IEnumerable<CIEMPOS.Models.TbPago>

@{
    ViewData["Title"] = "Pagos";
}

<h2>Pagos</h2>

<div class="card mb-4">

    <div class="card-header">
        <strong>Información de la Mensualidad</strong>
    </div>

    <div class="card-body">

        <div class="row mb-2">

            <div class="col-md-4">
                <strong>Monto Mensualidad:</strong><br />
                @(((decimal)ViewBag.MontoBase).ToString("C"))
            </div>

            <div class="col-md-4">
                <strong>Monto IVA:</strong><br />
                @(((decimal)ViewBag.Iva).ToString("C"))
            </div>

            <div class="col-md-4">
                <strong>Total Mensualidad:</strong><br />
                <strong>@(((decimal)ViewBag.Total).ToString("C"))</strong>
            </div>

        </div>

        <div class="mt-3">

            @if (ViewBag.IdRol == CIEMPOS.Helpers.Helper.ROL_ADMINISTRADOR)
            {
                <a asp-action="EditarMonto"
                   class="btn btn-warning">
                    Editar Monto
                </a>
            }

            <a asp-action="Create"
               class="btn btn-success">
                Registrar Nuevo Pago
            </a>

        </div>

    </div>

</div>

<hr />

<h4>Historial de Pagos</h4>

<form method="get"
      class="row g-3 mb-4">

    <div class="col-md-4">

        <label class="form-label">Paciente</label>

        <select name="idPaciente"
                asp-items="ViewBag.Pacientes"
                class="form-select">

            <option value="">
                Seleccione un paciente
            </option>

        </select>

    </div>

    <div class="col-md-3">

        <label class="form-label">Desde</label>

        <input type="date"
               name="fechaInicio"
               class="form-control"
               value="@ViewBag.FechaInicio?.ToString("yyyy-MM-dd")" />

    </div>

    <div class="col-md-3">

        <label class="form-label">Hasta</label>

        <input type="date"
               name="fechaFin"
               class="form-control"
               value="@ViewBag.FechaFin?.ToString("yyyy-MM-dd")" />

    </div>

    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary">
            Buscar
        </button>

    </div>

</form>

<table class="table table-striped table-bordered">

    <thead>

        <tr>

            <th>Paciente</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Recibido por</th>
            <th style="width:100px;">Acciones</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var pago in Model)
        {
            <tr>

                <td>
                    @($"{pago.IdPacienteNavigation?.IdPersonaNavigation?.Nombre} {pago.IdPacienteNavigation?.IdPersonaNavigation?.Apellido}")
                </td>

                <td>
                    @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @pago.Monto.ToString("C")
                </td>

                <td>
                    @($"{pago.IdUsuarioNavigation?.IdPersonaNavigation?.Nombre} {pago.IdUsuarioNavigation?.IdPersonaNavigation?.Apellido}")
                </td>

                <td>

                    <a asp-action="Ver"
                       asp-route-id="@pago.IdPago"
                       class="btn btn-info btn-sm">
                        Ver
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>