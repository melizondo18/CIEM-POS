@*
    Permite registrar un nuevo pago.
*@

@model CIEMPOS.Models.TbPago

@{
    ViewData["Title"] = "Registrar Pago";
}

<h2 style="color:red">⭐⭐⭐⭐⭐ ESTA ES LA VISTA DE PAGO ⭐⭐⭐⭐⭐</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @Html.Raw(ViewBag.Error)
    </div>
}

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">

        <label class="form-label">
            Paciente
        </label>

        <select asp-for="IdPaciente"
                asp-items="ViewBag.Pacientes"
                class="form-select">

            <option value="">
                Seleccione un paciente
            </option>

        </select>

        <span asp-validation-for="IdPaciente"
              class="text-danger">
        </span>

    </div>

    <hr />

    <h5>Información del Pago</h5>

    <div class="row">

        <div class="col-md-4 mb-3">

            <label class="form-label">
                Monto Mensualidad
            </label>

            <input class="form-control"
                   value="@(((decimal)ViewBag.MontoBase).ToString("C"))"
                   readonly />

        </div>

        <div class="col-md-4 mb-3">

            <label class="form-label">
                Monto IVA
            </label>

            <input class="form-control"
                   value="@(((decimal)ViewBag.Iva).ToString("C"))"
                   readonly />

        </div>

        <div class="col-md-4 mb-3">

            <label class="form-label">
                Total Mensualidad
            </label>

            <input class="form-control"
                   value="@(((decimal)ViewBag.Total).ToString("C"))"
                   readonly />

        </div>

    </div>

    <div class="mb-3">

        <label asp-for="NumeroAutorizacion"
               class="form-label">
        </label>

        <input asp-for="NumeroAutorizacion"
               class="form-control"
               maxlength="50"
               inputmode="numeric"
               pattern="[0-9]*"
               placeholder="Ej. 123456789" />

        <span asp-validation-for="NumeroAutorizacion"
              class="text-danger">
        </span>

    </div>

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

        <button type="submit"
                class="btn btn-primary">
            Guardar
        </button>

    </div>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}