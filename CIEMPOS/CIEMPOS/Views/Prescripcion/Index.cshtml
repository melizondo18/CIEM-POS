@*
    Muestra el historial de prescripciones registradas en el sistema.
*@

@model IEnumerable<CIEMPOS.Models.TbPrescripcion>

@{
    ViewData["Title"] = "Prescripciones";
}

<h2>Prescripciones</h2>

<form method="get" class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">Paciente</label>
        <select name="idPaciente"
                asp-items="ViewBag.Pacientes"
                class="form-select">
            <option value="">Seleccione un paciente</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date"
               name="fechaInicio"
               class="form-control"
               value="@ViewBag.FechaInicio?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date"
               name="fechaFin"
               class="form-control"
               value="@ViewBag.FechaFin?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary me-2">
            Buscar
        </button>

        <a asp-action="Create"
           class="btn btn-success">
            Nueva Prescripción
        </a>

    </div>

</form>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Paciente</th>
            <th>Profesional</th>
            <th>Fecha</th>
            <th style="width:100px;">Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var prescripcion in Model)
        {
            <tr>

                <td>
                    @($"{prescripcion.IdPacienteNavigation?.IdPersonaNavigation?.Nombre} {prescripcion.IdPacienteNavigation?.IdPersonaNavigation?.Apellido}")
                </td>

                <td>
                    @($"{prescripcion.IdUsuarioNavigation?.IdPersonaNavigation?.Nombre} {prescripcion.IdUsuarioNavigation?.IdPersonaNavigation?.Apellido}")
                </td>

                <td>
                    @prescripcion.FechaPrescripcion.ToString("dd/MM/yyyy")
                </td>

                <td>

                    <a asp-action="Ver"
                       asp-route-id="@prescripcion.IdPrescripcion"
                       class="btn btn-info btn-sm">
                        Ver
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>