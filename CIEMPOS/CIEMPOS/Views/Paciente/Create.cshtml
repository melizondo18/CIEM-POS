@*
Permite registrar un nuevo paciente en el sistema.
*@

@model CIEMPOS.Models.TbPaciente

@{
    ViewData["Title"] = "Registrar Paciente";
}

<h2>Registrar Paciente</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @Html.Raw(ViewBag.Error)
    </div>
}

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="IdPersona" class="form-label"></label>
        <select asp-for="IdPersona"
                asp-items="ViewBag.Personas"
                class="form-select">
            <option value="">Seleccione una persona</option>
        </select>
        <span asp-validation-for="IdPersona" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="InformacionClinica" class="form-label"></label>
        <textarea asp-for="InformacionClinica"
                  class="form-control"
                  rows="5"
                  placeholder="Ingrese información relevante como lesiones, alergias, enfermedades o restricciones físicas."></textarea>
        <span asp-validation-for="InformacionClinica" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}