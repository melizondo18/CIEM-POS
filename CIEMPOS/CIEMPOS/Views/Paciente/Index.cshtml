@*
Muestra el listado de pacientes registrados en el sistema.
*@

@model IEnumerable<CIEMPOS.Models.TbPaciente>

@{
    ViewData["Title"] = "Pacientes";
}

<h2>Pacientes</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Paciente
    </a>
</div>

<form method="get" class="mb-3">
    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               id="mostrarInactivos"
               name="mostrarInactivos"
               value="true"
               @(ViewBag.MostrarInactivos ? "checked" : "")
               onchange="this.form.submit();" />

        <label class="form-check-label" for="mostrarInactivos">
            Mostrar pacientes inactivos
        </label>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Persona</th>
            <th>Información Clínica</th>
            <th>Estado</th>
            <th style="width: 120px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var paciente in Model)
        {
            <tr>
                <td>
                    @($"{paciente.IdPersonaNavigation?.Nombre} {paciente.IdPersonaNavigation?.Apellido}")
                </td>
                <td>
                    @paciente.InformacionClinica
                </td>
                <td>
                    @(paciente.Estado ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@paciente.IdPaciente"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>