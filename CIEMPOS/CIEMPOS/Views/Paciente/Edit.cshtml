@*
Permite modificar la información de un paciente existente.
*@

@model CIEMPOS.Models.TbPaciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<h2>Editar Paciente</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="IdPaciente" type="hidden" />
    <input asp-for="IdPersona" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Persona</label>
        <input class="form-control"
               value="@($"{Model.IdPersonaNavigation?.Nombre} {Model.IdPersonaNavigation?.Apellido}")"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="InformacionClinica" class="form-label"></label>
        <textarea asp-for="InformacionClinica"
                  class="form-control"
                  rows="5"
                  placeholder="Ingrese información relevante como lesiones, alergias, enfermedades o restricciones físicas."></textarea>
        <span asp-validation-for="InformacionClinica" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Estado" class="form-check-input" />
        <label class="form-check-label" for="Estado">
            Activo
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}